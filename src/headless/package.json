{
  "name": "@converse/headless",
  "version": "14.0.0",
  "description": "Converse.js Headless build",
  "author": "JC Brand <jc@opkode.com>",
  "type": "module",
  "contributors": [
    "cmrd Senya <senya@riseup.net>"
  ],
  "homepage": "https://conversejs.org",
  "license": "MPL-2.0",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/converse-headless.d.ts",
        "import": "./index-node.js"
      },
      "import": {
        "types": "./dist/converse-headless.d.ts",
        "default": "./dist/converse-headless.js"
      }
    },
    "./node": {
      "types": "./dist/converse-headless.d.ts",
      "import": "./index-node.js"
    },
    "./dist/*": "./dist/*"
  },
  "imports": {
    "#sizzle": {
      "node": "./shims/sizzle.js",
      "default": "sizzle"
    }
  },
  "main": "./dist/converse-headless.js",
  "types": "./dist/converse-headless.d.ts",
  "files": [
    "README.md",
    "dist/",
    "./**/*.html",
    "./**/*.js",
    "./**/*.ts",
    "./**/*.json",
    "./**/*.md",
    "./**/*.po",
    "./**/*.pot",
    "./**/*.scss",
    "./**/*.svg",
    "!types/**"
  ],
  "keywords": [
    "converse.js",
    "XMPP",
    "Jabber",
    "chat",
    "messaging",
    "chatrooms",
    "webchat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conversejs/converse.js.git",
    "directory": "src/headless"
  },
  "scripts": {
    "test": "cd ../.. && vitest run --project headless",
    "test:browser": "cd ../.. && vitest --project headless --browser.headless=false",
    "test:node": "cd ../.. && vitest run --project headless-node",
    "types": "cd ../.. && npm run types:headless"
  },
  "bugs": {
    "url": "https://github.com/conversejs/converse.js/issues"
  },
  "dependencies": {
    "@converse/log": "^0.1.0",
    "@converse/openpromise": "^0.0.5",
    "@converse/skeletor": "^4.0.2",
    "@types/lodash": "^4.17.27",
    "@types/lodash-es": "^4.17.12",
    "@types/sdp-transform": "^3.0.0",
    "@types/sizzle": "^2.3.8",
    "dayjs": "^1.11.8",
    "filesize": "^11.0.13",
    "he": "^1.2.0",
    "hsluv": "^1.0.1",
    "libomemo.js": "^3.0.0",
    "lit": "^3.1.4",
    "lodash-es": "^4.17.21",
    "pluggable.js": "3.0.1",
    "sdp-transform": "^3.0.0",
    "sizzle": "^2.3.5",
    "sprintf-js": "^1.1.2",
    "strophe.js": "^6.0.0"
  },
  "optionalDependencies": {
    "@xmldom/xmldom": "^0.9.0",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
