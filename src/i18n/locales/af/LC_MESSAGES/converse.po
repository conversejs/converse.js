msgstr "'n Fout het voorgekom tydens betreding van hierdie groepgesprek"

#: dist/converse-no-dependencies.js:54827
#, javascript-format
msgid "%1$s has gone offline"
msgstr "%1$s is nou aflyn"

#: dist/converse-no-dependencies.js:54831
#, javascript-format
msgid "%1$s is busy"
msgstr "%1$s is besig"

#: dist/converse-no-dependencies.js:54833
#, javascript-format
msgid "%1$s is online"
msgstr "%1$s aangemeld"

#: dist/converse-no-dependencies.js:57218
msgid "This groupchat is not anonymous"
msgstr "Hierdie groepgesprek is nie anoniem nie"

#: dist/converse-no-dependencies.js:57219
