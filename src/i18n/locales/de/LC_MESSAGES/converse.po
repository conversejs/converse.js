#: dist/converse-no-dependencies.js:37001
msgid "Could not automatically determine a connection URL"
msgstr "Automatische Ermittlung einer Verbindungs-URL nicht möglich"

#: dist/converse-no-dependencies.js:37337
#: dist/converse-no-dependencies.js:37390
msgid "An error occurred while connecting to the chat server."
msgstr "Beim Verbinden mit dem Chatserver ist ein Fehler aufgetreten."

#: dist/converse-no-dependencies.js:37397
msgid "Your XMPP address and/or password is incorrect. Please try again."
msgstr ""
"Ihre XMPP-Adresse und/oder Ihr Kennwort sind falsch. Bitte versuchen Sie es "
"noch einmal."

#: dist/converse-no-dependencies.js:37406
#, javascript-format
msgid "We could not connect to %1$s, is your XMPP address correct?"
msgstr ""
"Wir konnten keine Verbindung zu %1$s herstellen, ist Ihre XMPP-Adresse "
"korrekt?"

#: dist/converse-no-dependencies.js:37408
msgid "The XMPP server rejected the connection because of a policy violation"
msgstr ""
"Der XMPP-Server hat die Verbindung aufgrund einer Richtlinienverletzung "
"abgelehnt"

#: dist/converse-no-dependencies.js:37410
msgid "The XMPP server did not offer a supported authentication mechanism"
msgstr ""
"Der XMPP-Server hat keinen unterstützten Authentifizierungsmechanismus "
"angeboten"

#: dist/converse-no-dependencies.js:44370
msgid "Undecryptable OMEMO message"
msgstr "Unentschlüsselbare OMEMO-Nachricht"

#: dist/converse-no-dependencies.js:44470
msgid "Sorry, could not determine upload URL."
msgstr "Leider konnte die Upload-URL nicht ermittelt werden."

#: dist/converse-no-dependencies.js:44487
msgid "Sorry, could not determine file upload URL."
msgstr "Leider konnte die URL für den Datei-Upload nicht ermitteln werden."

#: dist/converse-no-dependencies.js:44563
#, javascript-format
msgid ""
"Sorry, could not successfully upload your file. Your server’s response: "
"\"%1$s\""
msgstr ""
"Leider konnte die Datei nicht hochgeladen werden. Ihr Server antwortete mit: "
"„%1$s“"

#: dist/converse-no-dependencies.js:44565
msgid "Sorry, could not successfully upload your file."
msgstr "Leider konnte Ihre Datei nicht erfolgreich hochgeladen werden."

#: dist/converse-no-dependencies.js:45134
#: dist/converse-no-dependencies.js:52904
#, javascript-format
msgid "%1$s is typing"
msgstr "%1$s schreibt"

#: dist/converse-no-dependencies.js:45136
#: dist/converse-no-dependencies.js:52906
#, javascript-format
msgid "%1$s has stopped typing"
msgstr "%1$s schreibt nicht mehr"

#: dist/converse-no-dependencies.js:45138
#: dist/converse-no-dependencies.js:52908
#: dist/converse-no-dependencies.js:54829
#, javascript-format
msgid "%1$s has gone away"
msgstr "%1$s ist jetzt abwesend"

#: dist/converse-no-dependencies.js:45619
#: dist/converse-no-dependencies.js:45637
msgid "Sorry, looks like file upload is not supported by your server."
msgstr ""
"Leider sieht es so aus, als ob das Hochladen von Dateien von Ihrem Server "
"nicht unterstützt wird."

#: dist/converse-no-dependencies.js:45668
#, javascript-format
msgid ""
"The size of your file, %1$s, exceeds the maximum allowed by your server."
msgstr ""
"Die Größe Ihrer Datei, %1$s, überschreitet das erlaubte Maximum vom Server."

#: dist/converse-no-dependencies.js:45668
#, javascript-format
msgid ""
"The size of your file, %1$s, exceeds the maximum allowed by your server, "
"which is %2$s."
msgstr ""
"Die Größe Ihrer Datei, %1$s, überschreitet das erlaubte Maximum vom Server, "
"welches bei %2$s liegt."

#: dist/converse-no-dependencies.js:46244
#: dist/converse-no-dependencies.js:50452
msgid "You're not allowed to retract your message."
msgstr "Sie dürfen Ihre Nachricht nicht widerrufen."

#: dist/converse-no-dependencies.js:46246
#: dist/converse-no-dependencies.js:50456
msgid "Sorry, an error occurred while trying to retract your message."
msgstr ""
"Leider ist ein Fehler beim Versuch Ihre Nachricht zu widerrufen aufgetreten."

#: dist/converse-no-dependencies.js:46251
msgid "You're not allowed to send a message."
msgstr "Sie dürfen keine Nachricht senden."

#: dist/converse-no-dependencies.js:46253
#: dist/converse-no-dependencies.js:50465
msgid "Sorry, an error occurred while trying to send your message."
msgstr "Leider ist beim Senden Ihrer Nachricht ein Fehler aufgetreten."

#: dist/converse-no-dependencies.js:47576
msgid "Frequently used"
msgstr "Häufig verwendet"

#: dist/converse-no-dependencies.js:47577
msgid "Smileys and emotions"
msgstr "Smileys und Emotionen"

#: dist/converse-no-dependencies.js:47578
msgid "People"
msgstr "Menschen"

#: dist/converse-no-dependencies.js:47579
msgid "Activities"
msgstr "Aktivitäten"

#: dist/converse-no-dependencies.js:47580
msgid "Travel"
msgstr "Reisen"

#: dist/converse-no-dependencies.js:47581
msgid "Objects"
msgstr "Objekte"

#: dist/converse-no-dependencies.js:47582
msgid "Animals and nature"
msgstr "Tiere und Natur"

#: dist/converse-no-dependencies.js:47583
msgid "Food and drink"
msgstr "Essen und Trinken"

#: dist/converse-no-dependencies.js:47584
msgid "Symbols"
msgstr "Symbole"

#: dist/converse-no-dependencies.js:47585
msgid "Flags"
msgstr "Flaggen"

#: dist/converse-no-dependencies.js:47586
msgid "Stickers"
msgstr "Aufkleber"

#: dist/converse-no-dependencies.js:50454
msgid ""
"Your retraction was not delivered because you're not present in the "
"groupchat."
msgstr ""
"Ihr Widerruf wurde nicht zugestellt, weil Sie nicht im Gruppenchat vertreten "
"sind."

#: dist/converse-no-dependencies.js:50461
msgid "Your message was not delivered because you weren't allowed to send it."
msgstr ""
"Ihre Nachricht wurde nicht zugestellt, weil Sie sie nicht abschicken durften."

#: dist/converse-no-dependencies.js:50463
msgid ""
"Your message was not delivered because you're not present in the groupchat."
msgstr ""
"Ihre Nachricht wurde nicht zugestellt, weil Sie im Gruppenchat nicht "
"vertreten sind."

#: dist/converse-no-dependencies.js:50806
msgid "A timeout happened while trying to retract your message."
msgstr ""
"Beim Versuch, Ihre Nachricht zurückzuziehen, ist eine Zeitüberschreitung "
"aufgetreten."

#: dist/converse-no-dependencies.js:51594
msgid "Sorry, an error happened while running the command."
msgstr "Leider ist bei der Ausführung des Befehls ein Fehler aufgetreten."

#: dist/converse-no-dependencies.js:51594
#: dist/converse-no-dependencies.js:124945
msgid "Check your browser's developer console for details."
msgstr "Einzelheiten finden Sie in der Entwicklerkonsole Ihres Browsers."

#: dist/converse-no-dependencies.js:51614
#: dist/converse-no-dependencies.js:51632
msgid "Error: couldn't find a groupchat participant based on your arguments"
msgstr ""
"Fehler: Konnte keinen Gruppenchatteilnehmer anhand Ihrer Kriterien finden"

#: dist/converse-no-dependencies.js:51622
msgid "Error: found multiple groupchat participant based on your arguments"
msgstr ""
"Fehler: Mehrere Gruppenchatteilnehmer basierend auf Ihren Kriterien gefunden"

#: dist/converse-no-dependencies.js:51647
#, javascript-format
msgid ""
"Error: the \"%1$s\" command takes two arguments, the user's nickname and "
"optionally a reason."
msgstr ""
"Fehler: Das „%1$s”-Kommando benötigt zwei Argumente: Den Spitznamen und "
"einen Grund."

#: dist/converse-no-dependencies.js:51732
msgid ""
"Forbidden: you do not have the necessary affiliation in order to do that."
msgstr "Verboten: Sie haben nicht die nötige Zugehörigkeit, um das zu tun."

#: dist/converse-no-dependencies.js:51763
msgid "Forbidden: you do not have the necessary role in order to do that."
msgstr "Verboten: Sie haben nicht die nötigen Rechte, um das zu tun."

#: dist/converse-no-dependencies.js:52112
msgid "You're not allowed to register yourself in this groupchat."
msgstr "Sie dürfen diesem Gruppenchat nicht beitreten."

#: dist/converse-no-dependencies.js:52114
msgid ""
"You're not allowed to register in this groupchat because it's members-only."
msgstr ""
"Sie dürfen sich in diesem Gruppenchat nicht anmelden, da er nur für "
"Mitglieder zugänglich ist."

