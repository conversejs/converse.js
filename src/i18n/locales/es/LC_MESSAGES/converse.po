#: dist/converse-no-dependencies.js:121486
#: dist/converse-no-dependencies.js:124946
#: dist/converse-no-dependencies.js:130520
#: dist/converse-no-dependencies.js:134400
msgid "Error"
msgstr "Error"

#: dist/converse-no-dependencies.js:61998
msgid ""
"Sorry, no devices found to which we can send an OMEMO encrypted message."
msgstr ""
"No se encontró ningún dispositivo compatible con mensajes cifrados de OMEMO."

#: dist/converse-no-dependencies.js:62008
msgid ""
"Cannot use OMEMO in this groupchat — it must be non-anonymous and members-"
"only."
msgstr ""
"No se puede utilizar OMEMO en esta cadena de grupos; debe ser no anónimo y "
"sólo miembros."

#: dist/converse-no-dependencies.js:62961
msgid ""
"This is an OMEMO encrypted message which your client doesn’t seem to "
"support. Find more information on https://conversations.im/omemo"
msgstr ""
"Esto es un mensaje cifrado con OMEMO el cual tu cliente parece no soportar. "
"Encuentra más información en https://conversations.im/omemo"

#: dist/converse-no-dependencies.js:63094
#, javascript-format
msgid ""
"%1$s doesn't appear to have a client that supports OMEMO. Encrypted chat "
"will no longer be possible in this grouchat."
msgstr ""
"%1$s no parece tener un cliente que soporte OMEMO. El cifrado ya no será "
"posible en esta conversación en grupo."

#: dist/converse-no-dependencies.js:63253
msgid ""
"Received an OMEMO encrypted message which could not be decrypted, because it "
"was not encrypted for this device."
msgstr ""
"Recibió un mensaje OMEMO cifrado el cual no pudo ser descifrado, debido a "
"que no estaba cifrado para este dispositivo."

#: dist/converse-no-dependencies.js:63261
msgid "Sorry, could not decrypt a received OMEMO message due to an error."
msgstr ""
"Lo sentimos, no se puede descifrar un mensaje OMEMO recibido debido a un "
"error."

#: dist/converse-no-dependencies.js:63296
msgid ""
"Sorry, could not decrypt a received OMEMO message because we don't have the "
"XMPP address for that user."
msgstr ""
"Lo sentimos, no se pudo descifrar un mensaje OMEMO recibido porque no "
"tenemos la dirección XMPP de ese usuario."

#: dist/converse-no-dependencies.js:66295
msgid "Timeout while trying to fetch archived messages."
msgstr "Se agotó el tiempo de espera al intentar obtener mensajes archivados."

#: dist/converse-no-dependencies.js:68505
#, javascript-format
msgid "Sorry, an error occurred while trying to add %1$s as a contact."
msgstr ""
"Lo sentimos, se produjo un error al intentar agregar %1$s como contacto."

#: dist/converse-no-dependencies.js:68776
msgid "This client does not allow presence subscriptions"
msgstr "Este cliente no permite las suscripciones presenciales"

#: dist/converse-no-dependencies.js:69159
msgid "me"
msgstr "yo"

#: dist/converse-no-dependencies.js:69464
msgid "Unsaved contacts"
msgstr "Contactos no guardados"

#: dist/converse-no-dependencies.js:69465
msgid "My contacts"
msgstr "Mis contactos"

#: dist/converse-no-dependencies.js:69466
