#: dist/converse-no-dependencies.js:53395
#, javascript-format
msgid "%1$s is now a member of this groupchat"
msgstr "%1$s теперь является участником этого группового чата"

#: dist/converse-no-dependencies.js:53401
#, javascript-format
msgid "%1$s is now an %2$s of this groupchat"
msgstr "%1$s теперь %2$s этого группового чата"

#: dist/converse-no-dependencies.js:53527
msgid ""
"The nickname you chose is reserved or currently in use, please choose a "
"different one."
msgstr ""
"Выбранный вами псевдоним зарезервирован или используется в настоящее время, "
"выберите другой."

#: dist/converse-no-dependencies.js:53553
msgid "Password incorrect"
msgstr "Неверный пароль"

#: dist/converse-no-dependencies.js:53560
msgid "You are not on the member list of this groupchat."
msgstr "Вы не находитесь в списке участников этого группового чата."

#: dist/converse-no-dependencies.js:53568
msgid "You are not allowed to create new groupchats."
msgstr "Вам не разрешено создавать новые групповые чаты."

#: dist/converse-no-dependencies.js:53571
msgid "Your nickname doesn't conform to this groupchat's policies."
msgstr "Ваш псевдоним не соответствует правилам этого группового чата."

#: dist/converse-no-dependencies.js:53586
msgid "This groupchat does not (yet) exist."
msgstr "Этот групповой чат (пока) не существует."

#: dist/converse-no-dependencies.js:53589
msgid "This groupchat has reached its maximum number of participants."
msgstr "Этот групповой чат достиг максимального количества участников."

#: dist/converse-no-dependencies.js:53592
msgid "Remote server not found"
msgstr "Удалённый сервер не найден"

#: dist/converse-no-dependencies.js:53595
msgid "You're not allowed to enter this groupchat"
msgstr "Вам запрещено заходить в этот групповой чат"

#: dist/converse-no-dependencies.js:53598
msgid "An error happened while trying to enter this groupchat"
msgstr "При попытке зайти в групповой чат произошла ошибка"

#: dist/converse-no-dependencies.js:54827
#, javascript-format
msgid "%1$s has gone offline"
msgstr "%1$s вышел из сети"

#: dist/converse-no-dependencies.js:54831
#, javascript-format
msgid "%1$s is busy"
msgstr "%1$s занят"

#: dist/converse-no-dependencies.js:54833
#, javascript-format
msgid "%1$s is online"
msgstr "%1$s зашёл в сеть"

#: dist/converse-no-dependencies.js:57218
msgid "This groupchat is not anonymous"
msgstr "Этот групповой чат не анонимный"

#: dist/converse-no-dependencies.js:57219
msgid "This groupchat now shows unavailable members"
msgstr "В данный момент этот групповой чат показывает недоступных участников"

#: dist/converse-no-dependencies.js:57220
msgid "This groupchat does not show unavailable members"
msgstr "В этом групповом чате отсутствуют недоступные участники"

#: dist/converse-no-dependencies.js:57221
msgid "The groupchat configuration has changed"
msgstr "Изменена конфигурация группового чата"

#: dist/converse-no-dependencies.js:57222
msgid "Groupchat logging is now enabled"
msgstr "Журналирование группового чата теперь включено"

#: dist/converse-no-dependencies.js:57223
msgid "Groupchat logging is now disabled"
msgstr "Журналирование группового чата теперь отключено"

#: dist/converse-no-dependencies.js:57224
msgid "This groupchat is now no longer anonymous"
msgstr "Этот групповой чат больше не анонимен"

#: dist/converse-no-dependencies.js:57225
msgid "This groupchat is now semi-anonymous"
msgstr "Этот групповой чат частично анонимный"

#: dist/converse-no-dependencies.js:57226
msgid "This groupchat is now fully-anonymous"
msgstr "Этот групповой чат стал полностью анонимный"

#: dist/converse-no-dependencies.js:57227
msgid "A new groupchat has been created"
msgstr "Появился новый групповой чат"

#. XXX: Note the triple underscore function and not double underscore.
#: dist/converse-no-dependencies.js:57229
#, javascript-format
msgid "Your nickname has been automatically set to %1$s"
msgstr "Ваш псевдоним был автоматически изменён на: %1$s"

#: dist/converse-no-dependencies.js:57230
msgid "You have been banned from this groupchat"
msgstr "Вам запрещено подключаться к этому групповому чату"

#. XXX: Note the triple underscore function and not double underscore.
#: dist/converse-no-dependencies.js:57232
#, javascript-format
msgid "Your nickname has been changed to %1$s"
msgstr "Ваш псевдоним был изменён на: %1$s"

#: dist/converse-no-dependencies.js:57233
msgid "You have been kicked from this groupchat"
msgstr "Вас исключили из группового чата"

#: dist/converse-no-dependencies.js:57234
msgid ""
"You have been removed from this groupchat because of an affiliation change"
msgstr "Вас удалили из-за изменения прав"

#: dist/converse-no-dependencies.js:57235
msgid ""
"You have been removed from this groupchat because it has changed to members-"
"only and you're not a member"
msgstr ""
"Вы были удалены из этого группового чата, т.к. его режим был сменён на \"по "
"приглашению\", а вы не были приглашены"

#: dist/converse-no-dependencies.js:57236
msgid ""
"You have been removed from this groupchat because the service hosting it is "
"being shut down"
msgstr "Вы были удалены из этого группового чата по причине отключения хоста"

#: dist/converse-no-dependencies.js:57237
msgid "You have exited this groupchat due to a technical problem"
msgstr "Вы вышли из группового чата из-за технической проблемы"

#: dist/converse-no-dependencies.js:57798
msgid "Timeout Error"
msgstr "Ошибка времени ожидания"

#: dist/converse-no-dependencies.js:57799
msgid ""
"The server did not return your bookmarks within the allowed time. You can "
"reload the page to request them again."
msgstr ""
"Сервер не вернул ваши закладки в течение отмеренного ему времени. Вы можете "
"перезагрузить страницу, чтобы запросить их снова."

#: dist/converse-no-dependencies.js:58989
msgid "You are blocked from sending messages."
msgstr "Вам не разрешено отправлять сообщения."

#: dist/converse-no-dependencies.js:59727
msgid "A timeout occurred"
msgstr "Превышено время ожидания"

#: dist/converse-no-dependencies.js:61684
#, javascript-format
msgid ""
"Sorry, we're unable to send an encrypted message because %1$s requires you "
"to be subscribed to their presence in order to see their OMEMO information"
msgstr ""
"Извините, невозможно отправить зашифрованное сообщение, поскольку %1$s "
"требуют, чтобы вы были на них подписаны, чтобы увидеть их информацию об OMEMO"

#: dist/converse-no-dependencies.js:61686
#, javascript-format
msgid ""
"Sorry, we're unable to send an encrypted message because the remote server "
"for %1$s could not be found"
msgstr ""
"Извините, невозможно отправить зашифрованное сообщение, так как не удаётся "
"найти удалённый сервер для \"%1$s\""

#: dist/converse-no-dependencies.js:61688
msgid "Unable to send an encrypted message due to an unexpected error."
msgstr ""
"Не удаётся отправить зашифрованное сообщение из-за непредвиденной ошибки."

#: dist/converse-no-dependencies.js:61691
#: dist/converse-no-dependencies.js:61693
#: dist/converse-no-dependencies.js:94577
#: dist/converse-no-dependencies.js:94581
#: dist/converse-no-dependencies.js:94686
#: dist/converse-no-dependencies.js:99790
#: dist/converse-no-dependencies.js:99931
#: dist/converse-no-dependencies.js:99996
#: dist/converse-no-dependencies.js:111150
#: dist/converse-no-dependencies.js:121476
#: dist/converse-no-dependencies.js:121486
#: dist/converse-no-dependencies.js:124946
#: dist/converse-no-dependencies.js:130520
#: dist/converse-no-dependencies.js:134400
msgid "Error"
msgstr "Ошибка"

#: dist/converse-no-dependencies.js:61998
msgid ""
"Sorry, no devices found to which we can send an OMEMO encrypted message."
msgstr ""
"К сожалению, не найдено устройств, на которые можно отправить зашифрованное "
"сообщение OMEMO."

#: dist/converse-no-dependencies.js:62008
msgid ""
"Cannot use OMEMO in this groupchat — it must be non-anonymous and members-"
"only."
msgstr ""
"Невозможно использовать OMEMO в этом групповом чате — он должен быть "
"неанонимным и доступным только для участников."

#: dist/converse-no-dependencies.js:62961
msgid ""
"This is an OMEMO encrypted message which your client doesn’t seem to "
"support. Find more information on https://conversations.im/omemo"
msgstr ""
"Сообщение не поддерживается, т.к. оно зашифровано с помощью OMEMO. Более "
