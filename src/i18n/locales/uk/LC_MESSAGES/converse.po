#: dist/converse-no-dependencies.js:37001
msgid "Could not automatically determine a connection URL"
msgstr "Не вдалося автоматично визначити URL-адресу підключення"

#: dist/converse-no-dependencies.js:37337
#: dist/converse-no-dependencies.js:37390
msgid "An error occurred while connecting to the chat server."
msgstr "Під час підключення до сервера чату сталася помилка."

#: dist/converse-no-dependencies.js:37397
msgid "Your XMPP address and/or password is incorrect. Please try again."
msgstr ""
"Ваша XMPP-адреса та/або пароль неправильні. Будь ласка спробуйте ще раз."

#: dist/converse-no-dependencies.js:37406
#, javascript-format
msgid "We could not connect to %1$s, is your XMPP address correct?"
msgstr "Нам не вдалося підключитися до %1$s. Ваша XMPP-адреса правильна?"

#: dist/converse-no-dependencies.js:37408
msgid "The XMPP server rejected the connection because of a policy violation"
msgstr "Сервер XMPP відхилив з'єднання через порушення політики"

#: dist/converse-no-dependencies.js:37410
msgid "The XMPP server did not offer a supported authentication mechanism"
msgstr "Сервер XMPP не пропонує підтримуваний механізм автентифікації"

#: dist/converse-no-dependencies.js:44370
msgid "Undecryptable OMEMO message"
msgstr "Нешифроване повідомлення OMEMO"

#: dist/converse-no-dependencies.js:44470
msgid "Sorry, could not determine upload URL."
msgstr "На жаль, не вдалося визначити URL-адресу для завантаження."

#: dist/converse-no-dependencies.js:44487
msgid "Sorry, could not determine file upload URL."
msgstr "На жаль, не вдалося визначити URL-адресу для завантаження файлу."

#: dist/converse-no-dependencies.js:44563
#, javascript-format
msgid ""
"Sorry, could not successfully upload your file. Your server’s response: "
"\"%1$s\""
msgstr ""
"На жаль, не вдалося успішно завантажити ваш файл. Відповідь вашого сервера: "
"\"%1$s\""

#: dist/converse-no-dependencies.js:44565
msgid "Sorry, could not successfully upload your file."
msgstr "На жаль, не вдалося успішно завантажити ваш файл."

#: dist/converse-no-dependencies.js:45134
#: dist/converse-no-dependencies.js:52904
#, javascript-format
msgid "%1$s is typing"
msgstr "%1$s друкує"

#: dist/converse-no-dependencies.js:45136
#: dist/converse-no-dependencies.js:52906
#, javascript-format
msgid "%1$s has stopped typing"
msgstr "%1$s припинив(ла) набирати текст"

#: dist/converse-no-dependencies.js:45138
#: dist/converse-no-dependencies.js:52908
#: dist/converse-no-dependencies.js:54829
#, javascript-format
msgid "%1$s has gone away"
msgstr "%1$s відійшов(ла)"

#: dist/converse-no-dependencies.js:45619
#: dist/converse-no-dependencies.js:45637
msgid "Sorry, looks like file upload is not supported by your server."
msgstr ""
"На жаль, схоже, що завантаження файлів не підтримується вашим сервером."

#: dist/converse-no-dependencies.js:45668
#, javascript-format
msgid ""
"The size of your file, %1$s, exceeds the maximum allowed by your server."
msgstr "Розмір вашого файлу, %1$s, перевищує максимально дозволений сервером."

#: dist/converse-no-dependencies.js:45668
#, javascript-format
msgid ""
"The size of your file, %1$s, exceeds the maximum allowed by your server, "
"which is %2$s."
msgstr ""
"Розмір вашого файлу, %1$s, перевищує щонайбільш дозволений вашим сервером, "
"який становить %2$s."

#: dist/converse-no-dependencies.js:46244
#: dist/converse-no-dependencies.js:50452
msgid "You're not allowed to retract your message."
msgstr "Вам не дозволено відкликати своє повідомлення."

#: dist/converse-no-dependencies.js:46246
#: dist/converse-no-dependencies.js:50456
msgid "Sorry, an error occurred while trying to retract your message."
msgstr "На жаль, сталася помилка під час спроби відкликати ваше повідомлення."

#: dist/converse-no-dependencies.js:46251
msgid "You're not allowed to send a message."
msgstr "Вам не дозволяється надсилати повідомлення в цій кімнаті."

#: dist/converse-no-dependencies.js:46253
#: dist/converse-no-dependencies.js:50465
msgid "Sorry, an error occurred while trying to send your message."
msgstr "Трапилася помилка при спробі вiдправити ваше повiдомлення."

