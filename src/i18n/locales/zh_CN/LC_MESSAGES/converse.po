msgid "No users with that affiliation found."
msgstr "未找到具有该从属关系的用户。"

#: dist/converse-no-dependencies.js:89326
msgid "No users with that role found."
msgstr "未找到具有该角色的用户。"

#: dist/converse-no-dependencies.js:89327
